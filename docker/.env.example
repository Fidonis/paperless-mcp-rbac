# Environment for docker/docker-compose.yml.
# Copy this file to docker/.env and fill in real values.
# docker/.env is gitignored and MUST NOT be committed.

# --- OIDC / Keycloak ---
# This compose does NOT run Keycloak. Point this at an external OIDC provider
# (a Keycloak realm URL) that is reachable from inside the container.
OIDC_ISSUER_URL=https://keycloak.example.com/realms/myrealm
# Audience claim that must be present in the access token.
OIDC_AUDIENCE=mcp-paperless
# JWKS cache TTL in seconds.
OIDC_JWKS_CACHE_TTL=3600

# --- Paperless-ngx ---
# Base URL reachable from inside the container (use service name if on same network).
PAPERLESS_URL=http://paperless:8000
# Wire header forwarded to Paperless as the remote-user identifier.
# Must match PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME (WSGI form: HTTP_<UPPER_UNDERSCORED>).
PAPERLESS_REMOTE_USER_HEADER=X-Papaia-Remote-User
# JWT claim used as the remote-user value.
PAPERLESS_USERNAME_CLAIM=preferred_username
# HTTP timeout for Paperless calls in seconds.
PAPERLESS_HTTP_TIMEOUT=30
# Maximum response size for download_document in bytes (default 10 MiB).
PAPERLESS_MAX_DOWNLOAD_BYTES=10485760

# --- MCP server ---
# MCP_PORT controls the listen port inside the container AND the published host
# port — changing it here is sufficient; compose and the health-check both read
# this value.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# --- Logging ---
LOG_LEVEL=INFO
